# Copy this file to `.env` and fill in real values (from Supabase Dashboard → Settings → API).
# `.env` itself is gitignored and never committed — this file is the template that IS committed,
# so anyone setting up the project (including Vercel) knows which variables to set, without ever
# seeing the real values.

# Publishable/anon key — safe to expose to the browser by design; access is enforced by the
# Row Level Security policies in supabase/schema.sql, not by keeping this key secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same two values again, prefixed VITE_ — Vite only bundles env vars with this prefix into the
# browser-side build, so the frontend needs its own copies of the same URL/key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# service_role / secret key is intentionally NOT listed here — it's only ever needed for the
# one-off migration script (supabase/migrate.mjs) and should never live in a committed file,
# a running deployment, or an env var on any server. See that script's comments for how to use
# a temporary one when needed.
